# Machine-to-machine keys (comma-separated). Example includes a local dev key.
SANDBOX_API_KEYS=dev-local-key

# LiteLLM / model providers (configure at least one provider supported by LiteLLM)
LITELLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Nia (documentation + repository grounding)
NIA_API_KEY=
NIA_BASE_URL=https://apigcp.trynia.ai/v2

# Greptile (repo-aware analysis)
GREPTILE_API_KEY=
GITHUB_TOKEN=
GREPTILE_BASE_URL=https://api.greptile.com/v2

# AllScale (payment simulation — dry-run only in this MVP)
ALLSCALE_API_KEY=
ALLSCALE_BASE_URL=https://api.allscale.io

# Local service URLs (adjust user/host/port to match your Postgres and Redis)
DATABASE_URL=postgresql+asyncpg://preflight:preflight@localhost:5432/preflight
REDIS_URL=redis://localhost:6379/0

# Temporal target (omit or leave empty to run evaluation inline in the API process)
TEMPORAL_TARGET=
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=preflight

# Web demo (server-side proxy to the API)
SANDBOX_SERVER_API_KEY=dev-local-key
