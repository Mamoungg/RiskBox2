# Machine-to-machine keys (comma-separated). Example includes a local dev key.
SANDBOX_API_KEYS=5LBQ94xAUXd3BT8ZQ0GmwzMXuHdizrJo

# LiteLLM — Grok via xAI (https://docs.litellm.ai/docs/providers/xai)
LITELLM_MODEL=xai/grok-3-mini
XAI_API_KEY=

# Nia (documentation + repository grounding)
NIA_API_KEY=
NIA_BASE_URL=https://apigcp.trynia.ai/v2

# Greptile (repo-aware analysis)
GREPTILE_API_KEY=
GITHUB_TOKEN=
GREPTILE_BASE_URL=https://api.greptile.com/v2

# AllScale (payment simulation — dry-run only in this MVP)
ALLSCALE_API_KEY=
ALLSCALE_BASE_URL=https://api.allscale.io

# Local service URLs (adjust user/host/port to match your Postgres and Redis)
DATABASE_URL=postgresql+asyncpg://preflight:preflight@localhost:5432/preflight
REDIS_URL=redis://localhost:6379/0

# Docker Compose (`infra/docker-compose.yml`) overrides DATABASE_URL, REDIS_URL, and TEMPORAL_TARGET
# for the api and worker services to use in-cluster hostnames. It sets TEMPORAL_TARGET=temporal:7233
# so evaluations run on Temporal; leave TEMPORAL_TARGET empty below for local (non-Compose) runs if you
# want inline evaluation without a worker.

# Temporal target (omit or leave empty to run evaluation inline in the API process)
TEMPORAL_TARGET=
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=preflight

# Web demo (server-side proxy to the API)
SANDBOX_SERVER_API_KEY=5LBQ94xAUXd3BT8ZQ0GmwzMXuHdizrJo
